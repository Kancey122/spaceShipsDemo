# Cockpit Dome - Hexagonal dome shape
# Flat base at y=0, dome rises to y=0.65

# Base ring (y=0.0, r=0.45, in XZ plane)
v  0.450  0.0   0.000
v  0.225  0.0   0.390
v -0.225  0.0   0.390
v -0.450  0.0   0.000
v -0.225  0.0  -0.390
v  0.225  0.0  -0.390

# Upper ring (y=0.35, r=0.35)
v  0.350  0.35  0.000
v  0.175  0.35  0.303
v -0.175  0.35  0.303
v -0.350  0.35  0.000
v -0.175  0.35 -0.303
v  0.175  0.35 -0.303

# Apex
v  0.000  0.65  0.000

# Base cap center
v  0.000  0.0   0.000

# Side lower panels (6 quads)
f 1 7 8 2
f 2 8 9 3
f 3 9 10 4
f 4 10 11 5
f 5 11 12 6
f 6 12 7 1

