# Weapon Cannon - Long thin 8-sided barrel
# Base at z=-1.0 (r=0.10), muzzle at z=1.0 (r=0.07)

# Base ring (z=-1.0, r=0.10)
v  0.100  0.000 -1.0
v  0.070  0.070 -1.0
v  0.000  0.100 -1.0
v -0.070  0.070 -1.0
v -0.100  0.000 -1.0
v -0.070 -0.070 -1.0
v  0.000 -0.100 -1.0
v  0.070 -0.070 -1.0

# Muzzle ring (z=1.0, r=0.07)
v  0.070  0.000  1.0
v  0.050  0.050  1.0
v  0.000  0.070  1.0
v -0.050  0.050  1.0
v -0.070  0.000  1.0
v -0.050 -0.050  1.0
v  0.000 -0.070  1.0
v  0.050 -0.050  1.0

# Base cap center
v  0.000  0.000 -1.0

# Muzzle cap center
v  0.000  0.000  1.0

