# Left Wing - Swept delta shape
# Root at X=0, tip extends in -X direction

# Top surface vertices (y=+0.06)
v  0.0   0.06   0.5
v  0.0   0.06  -0.8
v -2.5   0.06  -0.3
v -2.5   0.06   0.7

# Bottom surface vertices (y=-0.06)
v  0.0  -0.06   0.5
v  0.0  -0.06  -0.8
v -2.5  -0.06  -0.3
v -2.5  -0.06   0.7

# Top face (outward +Y)
f 1 2 3 4

# Bottom face (outward -Y)
f 8 7 6 5

# Front (leading) edge
f 4 8 5 1

# Back (trailing) edge
f 2 6 7 3

# Root edge (attaches to hull)
f 5 6 2 1

# Tip edge
f 3 7 8 4
